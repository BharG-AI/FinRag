# LLM + embeddings (any OpenAI-compatible endpoint)
OPENAI_API_KEY=sk-...
# FINRAG_LLM_BASE_URL=http://localhost:11434/v1   # uncomment for Ollama
FINRAG_LLM_MODEL=gpt-4o-mini
FINRAG_EMBED_MODEL=text-embedding-3-small

# SEC EDGAR requires a User-Agent identifying you
FINRAG_SEC_USER_AGENT=Your Name your.email@example.com
